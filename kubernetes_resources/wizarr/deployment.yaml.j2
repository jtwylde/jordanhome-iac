apiVersion: apps/v1
kind: Deployment
metadata:
  name: wizarr
  namespace: jellyfin
  labels:
    app.kubernetes.io/name: wizarr
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: wizarr
  template:
    metadata:
      labels:
        app.kubernetes.io/name: wizarr
    spec:
      volumes:
        - name: config
          persistentVolumeClaim:
            claimName: wizarr-config
      containers:
        - name: wizarr
          image: "ghcr.io/wizarrrr/wizarr"
          volumeMounts:
            - name: config
              mountPath: /data
          ports:
            - name: http
              containerPort: 5690
              protocol: TCP
          env:
            - name: PUID
              value: "1000"
            - name: PGID
              value: "1000"
            - name: DISABLE_BUILTIN_AUTH
              value: "false"