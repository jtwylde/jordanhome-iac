apiVersion: apps/v1
kind: Deployment
metadata:
  name: bazarr
  namespace: jellyfin
  labels:
    app.kubernetes.io/name: bazarr
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: bazarr
  template:
    metadata:
      labels:
        app.kubernetes.io/name: bazarr
    spec:
      volumes:
        - name: config
          persistentVolumeClaim:
            claimName: bazarr-config
        - name: library
          persistentVolumeClaim:
            claimName: media-library-pvc
      containers:
        - name: bazarr
          image: "linuxserver/bazarr"
          volumeMounts:
            - name: config
              mountPath: /config
            - name: library
              mountPath: /library
          ports:
            - name: http
              containerPort: 6767
              protocol: TCP
          env:
            - name: PUID
              value: "1000"
            - name: PGID
              value: "1000"