apiVersion: batch/v1
kind: CronJob
metadata:
  name: bazarr-backup-cron
  namespace: jellyfin
spec:
  schedule: "{{ config_backup_cron }}"
  concurrencyPolicy: Forbid
  jobTemplate:
    spec:
      template:
        spec:
          restartPolicy: OnFailure
          containers:
            - name: bazarr-backup
              image: alpine:latest
              command:
                - /bin/sh
                - -c
                - |
                  cp -TR /source/backup/ /dest/bazarr/

              volumeMounts:
                - name: source
                  mountPath: /source
                  readOnly: true
                - name: dest
                  mountPath: /dest

          volumes:
            - name: source
              persistentVolumeClaim:
                claimName: bazarr-config
            - name: dest
              persistentVolumeClaim:
                claimName: media-config-backups-pvc

