apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage
  namespace: homepage
  labels:
    app.kubernetes.io/name: homepage
data:
  kubernetes.yaml: |
    mode: cluster
    ingress: true # default, enable ingress
    traefik: true # enable traefik ingressRoute
  settings.yaml: |
    title: Jordan's Home
    color: slate
    layout:
      Base:
        header: false
        style: row
        columns: 2
        Left:
          header: false
          Apps:
            style: row
            columns: 2
          Media:
            style: row
            columns: 1
            Jellyfin:
              header: false
            Supporting:
              header: false
              style: row
              columns: 2
        Right:
          header: false
          Infrastructure:
            style: row
            columns: 1
          News:
            header: false

    cardStyle: hairline

    blockStyle: refined
    # bookmarksStyle: icons
    background: 
      image: /images/wallpaper.png
      blur: "xs" # sm, "", md, xl... see https://tailwindcss.com/docs/backdrop-blur
      saturate: 75 # 0, 50, 100... see https://tailwindcss.com/docs/backdrop-saturate
      brightness: 50 # 0, 50, 75... see https://tailwindcss.com/docs/backdrop-brightness
      opacity: 55 # 0-100
  custom.css: ""
  custom.js: ""
  bookmarks.yaml: |
    - Links:
        - Github:
            - abbr: GH
              href: https://github.com/jtwylde
  services.yaml: |
    - Base:
      - Left:
        - Apps:
          - Wiki:
              icon: /images/wiki-go.svg
              href: https://wiki.jordanhome.dev
              siteMonitor: http://wiki.jordanhome.dev
              statusStyle: "dot"
              description: "Homelab wiki"
          - Octoprint:
              icon: /images/octoprint.svg
              href: https://octoprint.jordanhome.dev
              siteMonitor: http://octoprint.jordanhome.dev
              statusStyle: "dot"
              description: "3D printing"
          - AMP:
              icon: /images/amp.png
              href: https://amp.jordanhome.dev
              siteMonitor: http://amp.jordanhome.dev
              statusStyle: "dot"
              description: "Game server"
        - Media:
          - Jellyfin:
              icon: /images/jellyfin.svg
              href: http://media.jordanhome.dev
              siteMonitor: http://media.jordanhome.dev
              description: "Media server"
              widget:
                type: jellyfin
                url: http://media.jordanhome.dev
                key: {{ homepage_jellyfin }}
                version: 2 # optional, default is 1
                enableBlocks: true # optional, defaults to false
                enableNowPlaying: false # optional, defaults to true
                enableUser: true # optional, defaults to false
                enableMediaControl: false # optional, defaults to true
                showEpisodeNumber: true # optional, defaults to false
                expandOneStreamToTwoRows: false # optional, defaults to true
          - Supporting:
            - Sonarr:
                icon: /images/sonarr.svg
                href: http://sonarr.media.jordanhome.dev
                siteMonitor: http://sonarr.media.jordanhome.dev
                description: "Show tracking"
                widget:
                  type: sonarr
                  url: https://sonarr.media.jordanhome.dev
                  key: {{ homepage_sonarr }}
                  enableQueue: false
            - Radarr:
                icon: /images/radarr.svg
                href: http://radarr.media.jordanhome.dev
                siteMonitor: http://radarr.media.jordanhome.dev
                description: "Movie tracking"
                widget:
                  type: radarr
                  url: https://radarr.media.jordanhome.dev
                  key: {{ homepage_radarr }}
                  fields: ["wanted", "queued", "movies"]
            - qBittorrent:
                icon: /images/qbittorrent.svg
                href: http://qbit.media.jordanhome.dev
                siteMonitor: http://qbit.media.jordanhome.dev
                description: "Torrent client"
                widget:
                  type: qbittorrent
                  url: http://qbit.media.jordanhome.dev
                  key: {{ homepage_qbit }}
                  enableLeechProgress: false 
                  enableLeechSize: false
                  fields: ["leech", "download", "seed"] 
            - Jellyseerr:
                icon: /images/jellyseerr.svg
                href: http://request.media.jordanhome.dev
                siteMonitor: http://request.media.jordanhome.dev
                description: "Media requests"
                widget:
                  type: seerr
                  url: http://request.media.jordanhome.dev
                  key: {{ homepage_jellyseerr }}
            - Prowlarr:
                icon: /images/prowlarr.svg
                href: http://prowlarr.media.jordanhome.dev
                siteMonitor: http://prowlarr.media.jordanhome.dev
                description: "Torrent indexer"
                widget:
                  type: prowlarr
                  url: https://prowlarr.media.jordanhome.dev
                  key: {{ homepage_prowlarr }}
                  fields: ["numberOfGrabs", "numberOfFailGrabs"]
            - Bazarr:
                icon: /images/bazarr.svg
                href: http://bazarr.media.jordanhome.dev
                siteMonitor: http://bazarr.media.jordanhome.dev
                description: "Subtitle grabber"
                widget:
                  type: bazarr
                  url: https://bazarr.media.jordanhome.dev
                  key: {{ homepage_bazarr }}
      - Right:
        - Infrastructure:
          - NAS:
              icon: /images/synology-dsm.svg
              href: https://nas.jordanhome.dev
              siteMonitor: https://nas.jordanhome.dev
              statusStyle: "dot"
              widget:
                type: diskstation
                url: https://nas.jordanhome.dev
                username: remote_stats
                password: {{ homepage_nas }}
                volume: volume_1 # optional
          - DNS:
              icon: /images/pi-hole.svg
              href: https://pihole.jordanhome.dev
              siteMonitor: https://pihole.jordanhome.dev
              statusStyle: "dot"
              widget:
                type: pihole
                url: http://pihole.jordanhome.dev
                version: 6 # required if running v6 or higher, defaults to 5
                key: {{ homepage_pihole }} # optional, in v6 can be your password or app password
          - Proxmox:
              icon: /images/proxmox-light.svg
              href: https://pihole.jordanhome.dev
              siteMonitor: https://pihole.jordanhome.dev
              statusStyle: "dot"
              widget:
                type: proxmox
                url: https://192.168.1.160:8006
                username: homepage@pve!homepage
                password: {{ homepage_pve }}
        - News:
          - Hacker News:
              href: https://news.ycombinator.com
              widget:
                type: feed
                url: https://news.ycombinator.com/rss
                maxItems: 5 # optional - defaults to 5
                layout: list # optional - possible values list, grid - defaults to list
                images: false # optional - set to false to hide images - defaults to true
          - Sydney Morning Herald:
              href: https://www.smh.com.au
              widget:
                type: feed
                url: https://www.smh.com.au/rss/feed.xml
                maxItems: 5 # optional - defaults to 5
                layout: list # optional - possible values list, grid - defaults to list
                images: false # optional - set to false to hide images - defaults to true
  widgets.yaml: |
    - datetime:
        text_size: xl
        format:
          timeStyle: short
    - search:
        provider: google
        target: _blank
    - openmeteo:
        label: Sydney # optional
        latitude: -35.282
        longitude: 149.129
        timezone: Australia/Sydney # optional
        units: metric # or imperial
        cache: 5 # Time in minutes to cache API responses, to stay within limits
        format: # optional, Intl.NumberFormat options
          maximumFractionDigits: 1
  docker.yaml: ""
  proxmox.yaml: ""