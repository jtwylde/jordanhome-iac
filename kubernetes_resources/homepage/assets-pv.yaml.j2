apiVersion: v1
kind: PersistentVolume
metadata:
  name: homepage-assets-pv
spec:
  capacity:
    storage: 5Gi
  accessModes:
    - ReadWriteMany
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  nfs:
    server: {{ hostvars['nas'].ansible_host }}
    path: /volume1/JordanNAS/app-assets/homepage