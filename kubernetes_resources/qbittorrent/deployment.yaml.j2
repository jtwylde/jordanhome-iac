apiVersion: apps/v1
kind: Deployment
metadata:
  name: qbittorrent
  namespace: jellyfin
  labels:
    app.kubernetes.io/name: qbittorrent
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: qbittorrent
  template:
    metadata:
      labels:
        app.kubernetes.io/name: qbittorrent
    spec:
      volumes:
        - name: config
          persistentVolumeClaim:
            claimName: qbittorrent-config
        - name: library
          persistentVolumeClaim:
            claimName: media-library-pvc
      containers:
        - name: qbittorrent
          image: "linuxserver/qbittorrent"
          volumeMounts:
            - name: config
              mountPath: /config
            - name: library
              mountPath: /library
          ports:
            - name: http
              containerPort: 8090
              protocol: TCP
            - name: torrenttcp
              containerPort: 6881
              protocol: TCP
            - name: torrentudp
              containerPort: 6881
              protocol: UDP
          env:
            - name: PUID
              value: "1000"
            - name: PGID
              value: "1000"
            - name: WEBUI_PORT
              value: "8090"
            - name: TORRENTING_PORT
              value: "6881"
            - name: DOCKER_MODS
              value: "ghcr.io/vuetorrent/vuetorrent-lsio-mod:latest"