# Default values for dashy.
# This is a YAML-formatted file.
# Declare variables to be passed into your templates.

replicaCount: 1

image:
  repository: lissy93/dashy
  pullPolicy: IfNotPresent
  # Overrides the image tag whose default is the chart appVersion.
  tag: "latest"

# Choose deployment strategy type
strategyType: Recreate

imagePullSecrets: []
nameOverride: ""
fullnameOverride: ""

serviceAccount:
  # Specifies whether a service account should be created
  create: true
  # Automatically mount a ServiceAccount's API credentials?
  automount: true
  # Annotations to add to the service account
  annotations: {}
  # The name of the service account to use.
  # If not set and create is true, a name is generated using the fullname template
  name: ""

podAnnotations: {}
podLabels: {}

probs:
  failureThreshold: 3
  timeoutSeconds: 10
  periodSeconds: 90
  initialDelaySeconds: 40
  path: "/"

podSecurityContext: {}
  # fsGroup: 2000

securityContext: {}
  # capabilities:
  #   drop:
  #   - ALL
  # readOnlyRootFilesystem: true
  # runAsNonRoot: true
  # runAsUser: 1000

service:
  type: ClusterIP
  port: 8080

ingress:
  enabled: true
  className: "traefik"
  annotations:
    kubernetes.io/ingress.class: traefik
    cert-manager.io/cluster-issuer: {{ issuer }}
  hosts:
    - host: {{ base_url }}
      paths:
        - path: /
          pathType: ImplementationSpecific
  tls:
    - secretName: dashy-web-cert
      hosts:
        - {{ base_url }}

resources: {}
  # We usually recommend not to specify default resources and to leave this as a conscious
  # choice for the user. This also increases chances charts run on environments with little
  # resources, such as Minikube. If you do want to specify resources, uncomment the following
  # lines, adjust them as necessary, and remove the curly braces after 'resources:'.
  # limits:
  #   cpu: 100m
  #   memory: 128Mi
  # requests:
  #   cpu: 100m
  #   memory: 128Mi

autoscaling:
  enabled: false
  minReplicas: 1
  maxReplicas: 10
  targetCPUUtilizationPercentage: 80
  # targetMemoryUtilizationPercentage: 80

# Additional volumes on the output Deployment definition.
volumes: []

# Additional volumeMounts on the output Deployment definition.
volumeMounts: []

nodeSelector: {}

tolerations: []

affinity: {}

env:
  NODE_ENV: "production"
  PORT: 8080
  #HOST: ""
  #BASE_URL: ""
  #VUE_APP_DOMAIN: ""
  #INTEGRITY: ""
  # -- Set this to the name of a secret to load environment variables from. If defined, values in the secret will override values in configs
  existingSecret: ""

static:
  # If set to true, configuration will be overwritten on every new releases.
  enabled: true

  # -- Set this to the name of a secret to load configuration from. If defined, values in the secret will override values in configs
  existingSecret: ""

  # Customize config.yaml https://github.com/Lissy93/dashy/blob/master/docs/configuring.md for more information.
  configMapContent:
    conf: |-
      # Page meta info, like heading, footer text and nav links
      pageInfo:
        title: Jordan's Dashboard

      # Optional app settings and configuration
      appConfig:
        theme: one-dark
        statusCheck: true

      # Main content - An array of sections, each containing an array of items
      sections:
        - name: Webapps
          icon: fas fa-rocket
          items:
            - title: Wiki
              description: Homelab Wiki
              icon: sh-wiki-go
              url: https://wiki.jordanhome.dev
            - title: Octoprint
              description: 3D Printing
              icon: sh-octoprint
              url: https://octoprint.jordanhome.dev
            - title: Headlamp
              description: Kubernetes Monitoring
              icon: sh-headlamp
              url: https://headlamp.jordanhome.dev
            - title: AMP
              description: Game Server
              icon: sh-cubecoders-amp
              url: https://amp.jordanhome.dev
            - title: Romm
              description: ROM Library
              icon: sh-romm
              url: https://romm.jordanhome.dev
        - name: Media
          icon: fas fa-compact-disc
          items:
            - title: Jellyfin
              description: Media Server
              icon: sh-jellyfin
              url: https://media.jordanhome.dev
            - title: Sonarr
              description: Series Grabber
              icon: sh-sonarr
              url: https://sonarr.media.jordanhome.dev
            - title: Radarr
              description: Movie Grabber
              icon: sh-radarr
              url: https://radarr.media.jordanhome.dev
            - title: Prowlarr
              description: Torrent Indexer
              icon: sh-prowlarr
              url: https://prowlarr.media.jordanhome.dev
            - title: Bazarr
              description: Subtitle Grabber
              icon: sh-bazarr
              url: https://bazarr.media.jordanhome.dev
            - title: Qbittorrent
              description: Torrent Server
              icon: sh-qbittorrent
              url: https://qbit.media.jordanhome.dev
            - title: Jellyseerr
              description: Media Requests
              icon: sh-jellyseerr
              url: https://request.media.jordanhome.dev


        - name: Hacker News
          icon: fas fa-code-branch
          displayData:
            cols: 1
            rows: 3
            cutToHeight: true
          widgets:
            - type: rss-feed
              useProxy: true
              options:
                rssUrl: https://news.ycombinator.com/rss
                parseLocally: true
                limit: 5

        - name: Infrastructure
          icon: fas fa-server
          widgets:
            - type: proxmox-lists
              useProxy: true 
              options:
                cluster_url: https://pve1.jordanhome.dev
                user_name: root@pam
                token_name: dashy
                token_uuid: {{ dashy_pve_api_key }}
                node: node0
                node_data: qemu
                title: Node-0 VMs
                title_as_link: true
                hide_templates: 1
            - type: proxmox-lists
              useProxy: true 
              options:
                cluster_url: https://pve2.jordanhome.dev
                user_name: root@pam
                token_name: dashy
                token_uuid: {{ dashy_pve_api_key }}
                node: node1
                node_data: qemu
                title: Node-1 VMs
                title_as_link: true
                hide_templates: 1
          items:
            - title: DNS
              description: DNS
              icon: sh-raspberry-pi
              url: https://pihole.jordanhome.dev/admin
            - title: NAS
              description: NAS Storage
              icon: sh-synology
              url: https://nas.jordanhome.dev

        - name: Do it for him
          icon: fas fa-heart
          displayData:
            itemSize: large
          widgets:
            - type: image
              options:
                imagePath: https://images-wixmp-ed30a86b8c4ca887773594c2.wixmp.com/f/c1d5f872-9b64-4c7c-bbef-b236ac75aa3c/dfpd079-813f8431-2fe9-4008-a012-bc8d1a769a4b.gif?token=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..ZfzBaOcrhmyI5VErIQM2M_hYIjc9zUlhDQsdziRJe9U