apiVersion: v1
kind: ConfigMap
metadata:
  name: git-ssh-config
  namespace: default
data:
  config: |
    Host github.com
      HostName github.com
      User git
      IdentityFile /home/www-data/.ssh/github-token
      IdentitiesOnly yes
      StrictHostKeyChecking yes
      UserKnownHostsFile /home/www-data/.ssh/known_hosts