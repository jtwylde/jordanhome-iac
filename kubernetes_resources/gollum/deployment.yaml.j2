apiVersion: apps/v1
kind: Deployment
metadata:
  name: gollum
  namespace: gollum
  labels:
    app.kubernetes.io/name: gollum
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: gollum
  template:
    metadata:
      labels:
        app.kubernetes.io/name: gollum
    spec:
      securityContext:
        fsGroup: 1000
      volumes:
        - name: config
          persistentVolumeClaim:
            claimName: gollum-config
      initContainers:
        - name: clone-wiki
          image: alpine/git
          command:
            - sh
            - -ec
            - |
              if [ ! -d /wiki/.git ]; then
                echo "Cloning wiki repository..."
                git clone --branch main "$WIKI_GIT_URL" /wiki
              else
                echo "Wiki repository already exists; skipping clone."
              fi
              chown -R 1000:1000 /wiki
          env:
          - name: WIKI_GIT_URL
            value: "https://jtwylde:{{ github_wiki }}@github.com/jtwylde/jordanhome-wiki.git"
          - name: PUID
            value: "1000"
          - name: PGID
            value: "1000"
          volumeMounts:
            - name: config
              mountPath: /wiki
      containers:
        - name: gollum
          image: "gollumwiki/gollum:6.1.0"
          args:
            - "--config /wiki/config.rb"
          volumeMounts:
            - name: config
              mountPath: /wiki
          ports:
            - name: http
              containerPort: 4567
              protocol: TCP
          env:
            - name: PUID
              value: "1000"
            - name: PGID
              value: "1000"