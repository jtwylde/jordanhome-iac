apiVersion: batch/v1
kind: CronJob
metadata:
  name: sonarr-backup-cron
  namespace: jellyfin
spec:
  schedule: "{{ config_backup_cron }}"
  concurrencyPolicy: Forbid
  jobTemplate:
    spec:
      template:
        spec:
          restartPolicy: OnFailure
          containers:
            - name: sonarr-backup
              image: alpine:latest
              command:
                - /bin/sh
                - -c
                - |
                  mkdir -p /dest/sonarr
                  [ -d "/source/Backups/scheduled" ] && cp -TR /source/Backups/scheduled/ /dest/sonarr/scheduled/
                  [ -d "/source/Backups/manual" ] && cp -TR /source/Backups/manual/ /dest/sonarr/manual/

              volumeMounts:
                - name: source
                  mountPath: /source
                  readOnly: true
                - name: dest
                  mountPath: /dest

          volumes:
            - name: source
              persistentVolumeClaim:
                claimName: sonarr-config
            - name: dest
              persistentVolumeClaim:
                claimName: media-config-backups-pvc

